# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual envs
.venv/
env/

# Data files — keep directory READMEs, ignore data artifacts
data/**/*.csv
data/**/*.data
data/**/*.txt
data/**/*.parquet
data/**/*.npy
data/**/*.npz
data/**/*.feather
data/**/*.pkl

# Model artifacts — keep README, ignore serialized models
models/*.pkl
models/*.joblib
models/*.json
models/*.bin

# Reports — keep markdown, ignore generated figures
reports/figures/*.png
reports/figures/*.svg
reports/figures/*.pdf
reports/figures/*.html
reports/*.npz
reports/batch_scores.csv

# Jupyter
.ipynb_checkpoints/

# ML experiment artifacts
mlruns/
*.log

# Misc
.env
.DS_Store
.vscode/

# Local scratch files
.pytest-run-temp/
tmp/
